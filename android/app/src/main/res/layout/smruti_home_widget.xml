<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="6dp"
    android:background="@drawable/smruti_widget_background"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="7dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_heading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="HariPrabodham Smruti"
            android:textColor="#FF6E271C"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_photo_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/smruti_widget_count"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="#FF6E271C"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_row_1"
        style="@style/SmrutiResponsiveRow" />

    <LinearLayout
        android:id="@+id/widget_row_2"
        style="@style/SmrutiResponsiveRow" />

    <LinearLayout
        android:id="@+id/widget_row_3"
        style="@style/SmrutiResponsiveRow" />

    <LinearLayout
        android:id="@+id/widget_row_4"
        style="@style/SmrutiResponsiveRow" />
</LinearLayout>
